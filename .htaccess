# Tylilo on HostM / Apache.
# index.php wins when a folder has one (the arcade list). Game folders
# only have index.html, and that file must still be served.
DirectoryIndex index.php index.html

Options -Indexes -MultiViews
AddDefaultCharset UTF-8

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^includes/ - [F,L]
  RewriteRule ^scripts/ - [F,L]
  RewriteRule ^data/ - [F,L]
  RewriteRule ^tests/ - [F,L]
  RewriteRule ^config\.php$ - [F,L]
  RewriteRule ^router\.php$ - [F,L]
  RewriteCond %{THE_REQUEST} \s/+accessibility\.php[\s?] [NC]
  RewriteRule ^accessibility\.php$ /accessibility [R=301,L]
  RewriteRule ^accessibility/?$ accessibility.php [L]
  RewriteCond %{THE_REQUEST} \s/+privacy\.php[\s?] [NC]
  RewriteRule ^privacy\.php$ /privacy [R=301,L]
  RewriteRule ^privacy/?$ privacy.php [L]
  RewriteCond %{THE_REQUEST} \s/+otradio/index\.php[\s?] [NC]
  RewriteRule ^otradio/index\.php$ /otradio/ [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+arcade/index\.php[\s?] [NC]
  RewriteRule ^arcade/index\.php$ /arcade/ [R=301,L]
  # /arcade/red-rain and /arcade/solitaire work with or without a slash.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ /$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.php

<IfModule mod_setenvif.c>
  SetEnvIf Query_String "(^|&)v=[0-9]+$" tylilo_versioned
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # HTML revalidates. PHP also sends no-cache (not no-store) so back/forward cache can work.
  # Keep-alive, HTTP/2, and HTTP/3 are LiteSpeed settings on HostM, not .htaccess.
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, private"
  </FilesMatch>
  # ?v=<filemtime> assets are immutable: the URL changes when the file does.
  <FilesMatch "\.(css|js|mjs|woff2|webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable" env=tylilo_versioned
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Pages revalidate. CSS and JS stay cached for a week; their URLs include
  # ?v=<filemtime>, so a new file is a new address.
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
